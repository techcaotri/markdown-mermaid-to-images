                        "mermaid"
                    ],
                    []
                ],"%%{init: {\'theme\':\'base\'}}%%\\nsequenceDiagram\\n    participant W as Writer Process\\n    participant SF as Schema File\\n    participant SM as Shared Memory\\n    participant R as Reader Process\\n    \\n    %% Schema Creation Phase\\n    Note over W: Registration Phase\\n    W->>W: Create SchemaBuilder\\n    W->>W: Register struct types\\n    W->>W: Register array types\\n    W->>W: Set root type\\n    W->>SF: Generate & save schema\\n    \\n    %% Data Writing Phase\\n    Note over W,SM: Data Writing Phase\\n    W->>SM: Create shared memory\\n    W->>SM: Write POD data\\n    \\n    %% Schema Loading Phase\\n    Note over R: Schema Loading Phase\\n    R->>SF: Load schema file\\n    R->>R: Validate schema\\n    R->>R: Build type indexes\\n    \\n    %% Data Reading Phase\\n    Note over R,SM: Data Reading Phase\\n    R->>SM: Map shared memory\\n    R->>R: Interpret data<br/>using schema\\n    R->>R: Access fields"
            ]
        },
