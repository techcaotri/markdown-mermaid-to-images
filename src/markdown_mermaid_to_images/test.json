        {
            "t": "CodeBlock",
            "c": [
                [
                    "",
                    [
                        "cpp"
                    ],
                    []
                ],
                "// Simple struct with primitive fields\\nauto vector3d = builder.register_struct_type(\\"Vector3D\\");\\nvector3d.add_float_field(\\"x\\")\\n        .add_float_field(\\"y\\")\\n        .add_float_field(\\"z\\");\\nvector3d.finalize();\\n\\n// Struct with nested struct\\nauto pose = builder.register_struct_type(\\"Pose\\");\\npose.add_struct_field(\\"position\\", builder.get_type_id(\\"Vector3D\\"))\\n    .add_struct_field(\\"orientation\\", builder.get_type_id(\\"Quaternion\\"));\\npose.finalize();\\n\\n// Struct with string field\\nauto message = builder.register_struct_type(\\"Message\\");\\nmessage.add_uint64_field(\\"timestamp\\")\\n       .add_string_field(\\"text\\", 256)  // 256-byte capacity\\n       .add_uint32_field(\\"sender_id\\");\\nmessage.finalize();"
            ]
        },
