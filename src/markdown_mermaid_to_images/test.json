            "c": [
                [
                    "",
                    [
                        "cpp"
                    ],
                    []
                ],
                "#include \\"pod_transfer/pod_transfer.h\\"\\n#include <sys/mman.h>\\n#include <fcntl.h>\\n#include <iostream>\\n\\nvoid read_sensor_data() {\\n    // 1. Load schema\\n    pod_transfer::SchemaReader reader;\\n    if (!reader.load_from_file(\\"sensor.podt\\")) {\\n        std::cerr << \\"Failed to load schema\\" << std::endl;\\n        return;\\n    }\\n    \\n    // 2. Map shared memory\\n    int shm_fd = shm_open(\\"/sensor_data\\", O_RDONLY, 0666);\\n    if (shm_fd == -1) {\\n        perror(\\"shm_open\\");\\n        return;\\n    }\\n    \\n    void* shm_ptr = mmap(nullptr, reader.get_root_data_size(),\\n                         PROT_READ, MAP_SHARED, shm_fd, 0);\\n    if (shm_ptr == MAP_FAILED) {\\n        perror(\\"mmap\\");\\n        close(shm_fd);\\n        return;\\n    }\\n    \\n    // 3. Use Deserializer\\n    pod_transfer::Deserializer deserializer;\\n    deserializer.set_schema(&reader);\\n    deserializer.set_data(static_cast<const uint8_t*>(shm_ptr),\\n                         reader.get_root_data_size());\\n    \\n    if (!deserializer.is_valid()) {\\n        std::cerr << \\"Deserializer invalid: \\" \\n                  << deserializer.get_error_message() << std::endl;\\n        return;\\n    }\\n    \\n    // 4. Access data\\n    std::cout << \\"Reading sensor data...\\" << std::endl;\\n    \\n    // Print structure\\n    deserializer.print_structure();\\n    \\n    // Access specific values (example)\\n    for (int i = 0; i < 5; ++i) {\\n        std::string x_path = \\"lidar_points[\\" + std::to_string(i) + \\"
                ].position.x\\";\\n        std::string y_path = \\"lidar_points[\\" + std::to_string(i) + \\"
                ].position.y\\";\\n        std::string z_path = \\"lidar_points[\\" + std::to_string(i) + \\"
                ].position.z\\";\\n        \\n        float x, y, z;\\n        if (deserializer.get_field_value(x_path, x) &&\\n            deserializer.get_field_value(y_path, y) &&\\n            deserializer.get_field_value(z_path, z)) {\\n            std::cout << \\"Point \\" << i << \\": (\\" \\n                      << x << \\", \\" << y << \\", \\" << z << \\")\\" << std::endl;\\n        }\\n    }\\n    \\n    // 5. Cleanup\\n    munmap(shm_ptr, reader.get_root_data_size());\\n    close(shm_fd);\\n}"
            ]
        },
