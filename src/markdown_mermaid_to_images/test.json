        {
            "t": "CodeBlock",
            "c": [
                [
                    "",
                    [
                        "cpp"
                    ],
                    []
                ],
                "#include \\"pod_transfer/pod_transfer.h\\"\\n#include <sys/mman.h>\\n#include <fcntl.h>\\n\\n// Define your POD structure\\nstruct Point {\\n    float x, y, z;\\n};\\n\\nint main() {\\n    // 1. Create schema builder\\n    pod_transfer::SchemaBuilder builder;\\n    \\n    // 2. Register struct type\\n    auto point_builder = builder.register_struct_type(\\"Point\\");\\n    point_builder.add_float_field(\\"x\\")\\n                 .add_float_field(\\"y\\")\\n                 .add_float_field(\\"z\\");\\n    point_builder.finalize();\\n    \\n    // 3. Register array type\\n    auto array_id = builder.register_array_type(\\"points\\", \\n                                                 builder.get_type_id(\\"Point\\"), \\n                                                 100);\\n    \\n    // 4. Set root type and generate schema\\n    builder.set_root_type(\\"points\\");\\n    auto result = builder.generate_schema();\\n    \\n    if (!result.success) {\\n        std::cerr << \\"Failed: \\" << result.error_message << std::endl;\\n        return 1;\\n    }\\n    \\n    // 5. Save schema\\n    builder.save_schema_to_file(\\"points.podt\\");\\n    \\n    // 6. Create shared memory\\n    int shm_fd = shm_open(\\"/points_data\\", O_CREAT | O_RDWR, 0666);\\n    ftruncate(shm_fd, result.root_data_size);\\n    void* shm_ptr = mmap(nullptr, result.root_data_size, \\n                         PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);\\n    \\n    // 7. Write data\\n    Point* points = static_cast<Point*>(shm_ptr);\\n    for (int i = 0; i < 100; ++i) {\\n        points[i] = {float(i), float(i*2), float(i*3)};\\n    }\\n    \\n    msync(shm_ptr, result.root_data_size, MS_SYNC);\\n    std::cout << \\"Data written successfully!\\" << std::endl;\\n    \\n    return 0;\\n}"
            ]
        },
