                "#include \\"pod_transfer/pod_transfer.h\\"\\n#include <sys/mman.h>\\n#include <fcntl.h>\\n#include <cstring>\\n\\nstruct Vector3D {\\n    float x, y, z;\\n};\\n\\nstruct LidarPoint {\\n    Vector3D position;\\n    float intensity;\\n    uint16_t ring;\\n    uint16_t padding;\\n    uint64_t timestamp;\\n};\\n\\nstruct SensorDataset {\\n    LidarPoint lidar_points[5000];\\n};\\n\\nbool write_sensor_data() {\\n    // 1. Create and save schema (as shown in previous section)\\n    pod_transfer::SchemaBuilder builder;\\n    // ... register types ...\\n    auto result = builder.generate_schema();\\n    builder.save_schema_to_file(\\"sensor.podt\\");\\n    \\n    // 2. Create shared memory\\n    const char* shm_name = \\"/sensor_data\\";\\n    int shm_fd = shm_open(shm_name, O_CREAT | O_RDWR, 0666);\\n    ftruncate(shm_fd, result.root_data_size);\\n    \\n    void* shm_ptr = mmap(nullptr, result.root_data_size,\\n                         PROT_READ | PROT_WRITE,\\n                         MAP_SHARED, shm_fd, 0);\\n    \\n    // 3. Write data\\n    SensorDataset* dataset = static_cast<SensorDataset*>(shm_ptr);\\n    std::memset(dataset, 0, result.root_data_size);\\n    \\n    for (int i = 0; i < 5000; ++i) {\\n        dataset->lidar_points[i] = {\\n            {float(i), float(i*2), float(i*3)},  // position\\n            0.5f + (i % 100) / 100.0f,           // intensity\\n            uint16_t(i % 64),                     // ring\\n            0,                                    // padding\\n            uint64_t(i * 1000000)                 // timestamp\\n        };\\n    }\\n    \\n    // 4. Sync and cleanup\\n    msync(shm_ptr, result.root_data_size, MS_SYNC);\\n    munmap(shm_ptr, result.root_data_size);\\n    close(shm_fd);\\n    \\n    std::cout << \\"Data written successfully!\\" << std::endl;\\n    return true;\\n}"
            ]
        },
