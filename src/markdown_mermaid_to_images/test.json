                ],
                "// SchemaBuilder - Create schemas\\nclass SchemaBuilder {\\npublic:\\n    StructBuilder register_struct_type(const std::string& name);\\n    TypeId register_array_type(const std::string& name, TypeId element_type, uint32_t count);\\n    bool set_root_type(TypeId type_id);\\n    SchemaResult generate_schema();\\n    bool save_schema_to_file(const std::string& file_path);\\n    TypeId get_type_id(const std::string& name) const;\\n};\\n\\n// StructBuilder - Build struct definitions\\nclass StructBuilder {\\npublic:\\n    StructBuilder& add_int32_field(const std::string& name);\\n    StructBuilder& add_float_field(const std::string& name);\\n    StructBuilder& add_string_field(const std::string& name, uint32_t capacity);\\n    StructBuilder& add_struct_field(const std::string& name, TypeId type_id);\\n    StructBuilder& add_array_field(const std::string& name, TypeId array_type_id);\\n    StructType* finalize();\\n};"
            ]
        },
