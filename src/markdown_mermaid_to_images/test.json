            "t": "CodeBlock",
            "c": [
                [
                    "",
                    [
                        "cpp"
                    ],
                    []
                ],
                "#include \\"pod_transfer/pod_transfer.h\\"\\n\\nbool create_sensor_schema() {\\n    pod_transfer::SchemaBuilder builder;\\n    \\n    // 1. Register basic types\\n    auto vector3d = builder.register_struct_type(\\"Vector3D\\");\\n    vector3d.add_float_field(\\"x\\")\\n            .add_float_field(\\"y\\")\\n            .add_float_field(\\"z\\");\\n    vector3d.finalize();\\n    \\n    auto timestamp = builder.register_struct_type(\\"Timestamp\\");\\n    timestamp.add_uint64_field(\\"seconds\\")\\n             .add_uint32_field(\\"nanoseconds\\");\\n    timestamp.finalize();\\n    \\n    // 2. Register sensor data types\\n    auto lidar_point = builder.register_struct_type(\\"LidarPoint\\");\\n    lidar_point.add_struct_field(\\"position\\", builder.get_type_id(\\"Vector3D\\"))\\n               .add_float_field(\\"intensity\\")\\n               .add_uint16_field(\\"ring\\")\\n               .add_uint64_field(\\"timestamp\\");\\n    lidar_point.finalize();\\n    \\n    // 3. Register arrays\\n    auto lidar_array = builder.register_array_type(\\n        \\"lidar_points\\", \\n        builder.get_type_id(\\"LidarPoint\\"), \\n        10000);\\n    \\n    // 4. Register root\\n    auto dataset = builder.register_struct_type(\\"SensorDataset\\");\\n    dataset.add_array_field(\\"lidar_points\\", lidar_array);\\n    dataset.finalize();\\n    \\n    builder.set_root_type(\\"SensorDataset\\");\\n    \\n    // 5. Generate and save\\n    auto result = builder.generate_schema();\\n    if (!result.success) {\\n        std::cerr << \\"Failed: \\" << result.error_message << std::endl;\\n        return false;\\n    }\\n    \\n    return builder.save_schema_to_file(\\"sensor.podt\\");\\n}"
            ]
        },
