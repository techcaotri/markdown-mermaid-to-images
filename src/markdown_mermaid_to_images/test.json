                ],"%%{init: {\'theme\':\'base\'}}%%\\nflowchart LR\\n\\n  %% Root\\n  PTP((\\"POD Transfer<br/>Protocol\\"))\\n\\n  %% Schema Creation (oval)\\n  SC([\\"Schema<br/>Creation\\"])\\n  SC_RT[\\"Register Types\\"]\\n  SC_DF[\\"Define Fields\\"]\\n  SC_GS[\\"Generate Schema\\"]\\n  SC_SF[\\"Save to File\\"]\\n\\n  PTP --> SC\\n  SC --> SC_RT\\n  SC --> SC_DF\\n  SC --> SC_GS\\n  SC --> SC_SF\\n\\n  %% Schema Reading (oval)\\n  SR([\\"Schema<br/>Reading\\"])\\n  SR_LS[\\"Load Schema\\"]\\n  SR_VL[\\"Validate\\"]\\n  SR_QT[\\"Query Types\\"]\\n  SR_GM[\\"Get Metadata\\"]\\n\\n  PTP --> SR\\n  SR --> SR_LS\\n  SR --> SR_VL\\n  SR --> SR_QT\\n  SR --> SR_GM\\n\\n  %% Data Reading (oval)\\n  DR([\\"Data<br/>Reading\\"])\\n  DR_MSM[\\"Map Shared Memory\\"]\\n  DR_DS[\\"Deserialize\\"]\\n  DR_AF[\\"Access Fields\\"]\\n  DR_NS[\\"Navigate Structures\\"]\\n\\n  PTP --> DR\\n  DR --> DR_MSM\\n  DR --> DR_DS\\n  DR --> DR_AF\\n  DR --> DR_NS\\n\\n  %% Metadata Generation (oval)\\n  MG([\\"Metadata<br/>Generation\\"])\\n  MG_GD[\\"Generate Docs\\"]\\n  MG_EI[\\"Export Info\\"]\\n  MG_IS[\\"Inspect Schema\\"]\\n\\n  PTP --> MG\\n  MG --> MG_GD\\n  MG --> MG_EI\\n  MG --> MG_IS\\n  \\n  %% Data Writing (oval)\\n  DW([\\"Data<br/>Writing\\"])\\n  DW_CSM[\\"Create Shared Memory\\"]\\n  DW_WP[\\"Write POD Structures\\"]\\n  DW_SD[\\"Sync Data\\"]\\n\\n  PTP --> DW\\n  DW --> DW_CSM\\n  DW --> DW_WP\\n  DW --> DW_SD"
