        {
            "t": "CodeBlock",
            "c": [
                [
                    "",
                    [
                        "cpp"
                    ],
                    []
                ],
                "#include \\"pod_transfer/pod_transfer.h\\"\\n#include <chrono>\\n\\nclass Timer {\\n    std::chrono::high_resolution_clock::time_point start_;\\npublic:\\n    Timer() : start_(std::chrono::high_resolution_clock::now()) {}\\n    uint64_t elapsed_us() const {\\n        auto end = std::chrono::high_resolution_clock::now();\\n        return std::chrono::duration_cast<std::chrono::microseconds>(\\n            end - start_).count();\\n    }\\n};\\n\\nbool generate_with_metadata() {\\n    pod_transfer::TimingInfo timing;\\n    Timer total_timer;\\n    \\n    // 1. Create schema\\n    pod_transfer::SchemaBuilder builder;\\n    \\n    Timer struct_timer;\\n    // ... register struct types ...\\n    timing.struct_registration_us = struct_timer.elapsed_us();\\n    \\n    Timer array_timer;\\n    // ... register array types ...\\n    timing.array_registration_us = array_timer.elapsed_us();\\n    \\n    Timer schema_timer;\\n    auto result = builder.generate_schema();\\n    builder.save_schema_to_file(\\"sensor.podt\\");\\n    timing.schema_save_us = schema_timer.elapsed_us();\\n    \\n    // 2. Generate metadata using builder directly\\n    pod_transfer::MetadataGenerator metadata;\\n    metadata.set_schema_builder(&builder);  // Efficient - no file re-read\\n    metadata.set_schema_file_path(\\"sensor.podt\\");\\n    metadata.set_registration_method(\\"SchemaBuilder\\");\\n    metadata.set_write_method(\\"Direct\\");\\n    \\n    // Add array layouts\\n    size_t offset = 0;\\n    metadata.add_array_layout({\\n        \\"lidar_points\\", lidar_array_id, offset,\\n        sizeof(LidarPoint) * 5000, 5000,\\n        sizeof(LidarPoint), \\"LidarPoint\\"\\n    });\\n    \\n    // Add timing\\n    timing.total_us = total_timer.elapsed_us();\\n    metadata.set_timing_info(timing);\\n    \\n    // Save metadata\\n    if (!metadata.save_to_file(\\"sensor_metadata.txt\\")) {\\n        std::cerr << \\"Failed to save metadata\\" << std::endl;\\n        return false;\\n    }\\n    \\n    std::cout << \\"Schema and metadata generated successfully!\\" << std::endl;\\n    return true;\\n}"
            ]
        },
