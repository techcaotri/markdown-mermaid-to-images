        {
            "t": "CodeBlock",
            "c": [
                [
                    "",
                    [
                        "cpp"
                    ],
                    []
                ],
                "#include \\"pod_transfer/pod_transfer.h\\"\\n#include <sys/mman.h>\\n#include <fcntl.h>\\n\\nint main() {\\n    // 1. Load schema\\n    pod_transfer::SchemaReader reader;\\n    if (!reader.load_from_file(\\"points.podt\\")) {\\n        std::cerr << \\"Failed: \\" << reader.get_error_message() << std::endl;\\n        return 1;\\n    }\\n    \\n    // 2. Open shared memory\\n    int shm_fd = shm_open(\\"/points_data\\", O_RDONLY, 0666);\\n    void* shm_ptr = mmap(nullptr, reader.get_root_data_size(), \\n                         PROT_READ, MAP_SHARED, shm_fd, 0);\\n    \\n    // 3. Read data using schema\\n    const uint8_t* data_ptr = static_cast<const uint8_t*>(shm_ptr);\\n    \\n    // Get array type information\\n    uint32_t root_type_id = reader.get_type_id_by_name(\\"points\\");\\n    const pod_transfer::pod_type_descriptor_t* array_td = \\n        reader.get_type_descriptor(root_type_id);\\n    \\n    uint32_t element_count = array_td->array_info.element_count;\\n    uint32_t element_type_id = array_td->array_info.element_type_index;\\n    const pod_transfer::pod_type_descriptor_t* elem_td = \\n        reader.get_type_descriptor(element_type_id);\\n    \\n    // 4. Print data\\n    std::cout << \\"Reading \\" << element_count << \\" points:\\" << std::endl;\\n    for (uint32_t i = 0; i < 5 && i < element_count; ++i) {\\n        const float* point = reinterpret_cast<const float*>(\\n            data_ptr + i * elem_td->size);\\n        std::cout << \\"Point \\" << i << \\": (\\"\\n                  << point[0] << \\", \\" << point[1] << \\", \\" << point[2]\\n                  << \\")\\" << std::endl;\\n    }\\n    \\n    munmap(shm_ptr, reader.get_root_data_size());\\n    close(shm_fd);\\n    \\n    return 0;\\n}"
            ]
        },
