                ],
                "packet-beta\\n    title \\"SensorDataset Shared Memory Layout (Header + Expanded Element Layouts)\\"\\n\\n    %% SensorDataset header: 3 pointers (64 bits each)\\n    0-63:     \\"SensorDataset.lidar_points: pointer (64 bits)\\"\\n    64-127:   \\"SensorDataset.camera_frames: pointer (64 bits)\\"\\n    128-191:  \\"SensorDataset.imu_measurements: pointer (64 bits)\\"\\n\\n    %% --- LidarPoint element (224 bits, fully expanded) ---\\n    +32:      \\"LidarPoint.position.x: float32\\"\\n    +32:      \\"LidarPoint.position.y: float32\\"\\n    +32:      \\"LidarPoint.position.z: float32\\"\\n    +32:      \\"LidarPoint.intensity: float32\\"\\n    +16:      \\"LidarPoint.ring: uint16_t\\"\\n    +16:      \\"LidarPoint.padding: uint16_t\\"\\n    +64:      \\"LidarPoint.timestamp: uint64_t\\"\\n\\n    %% --- CameraFrame element (352 bits, fully expanded) ---\\n    +64:      \\"CameraFrame.timestamp: uint64_t\\"\\n    +32:      \\"CameraFrame.frame_id: uint32_t\\"\\n    +32:      \\"CameraFrame.width: uint32_t\\"\\n    +32:      \\"CameraFrame.height: uint32_t\\"\\n    +32:      \\"CameraFrame.channels: uint32_t\\"\\n    +32:      \\"CameraFrame.exposure_time: float32\\"\\n    +32:      \\"CameraFrame.gain: float32\\"\\n    +8:       \\"CameraFrame.white_balance.r: uint8_t\\"\\n    +8:       \\"CameraFrame.white_balance.g: uint8_t\\"\\n    +8:       \\"CameraFrame.white_balance.b: uint8_t\\"\\n    +8:       \\"CameraFrame.white_balance.a: uint8_t\\"\\n    +32:      \\"CameraFrame.padding: uint32_t\\"\\n    +32:      \\"CameraFrame.reserved: uint32_t\\"\\n\\n    %% --- ImuMeasurement element (512 bits, fully expanded) ---\\n    %% Timestamp\\n    +64:      \\"Imu.timestamp.seconds: uint64_t\\"\\n    +32:      \\"Imu.timestamp.nanoseconds: uint32_t\\"\\n    +32:      \\"Imu.timestamp.padding: uint32_t\\"\\n\\n    %% linear_acceleration (Vector3D)\\n    +32:      \\"Imu.linear_acceleration.x: float32\\"\\n    +32:      \\"Imu.linear_acceleration.y: float32\\"\\n    +32:      \\"Imu.linear_acceleration.z: float32\\"\\n\\n    %% angular_velocity (Vector3D)\\n    +32:      \\"Imu.angular_velocity.x: float32\\"\\n    +32:      \\"Imu.angular_velocity.y: float32\\"\\n    +32:      \\"Imu.angular_velocity.z: float32\\"\\n\\n    %% orientation (Quaternion)\\n    +32:      \\"Imu.orientation.w: float32\\"\\n    +32:      \\"Imu.orientation.x: float32\\"\\n    +32:      \\"Imu.orientation.y: float32\\"\\n    +32:      \\"Imu.orientation.z: float32\\"\\n\\n    %% tail\\n    +32:      \\"Imu.sequence: uint32_t\\"\\n    +32:      \\"Imu.padding: uint32_t\\"\\n"
            ]
