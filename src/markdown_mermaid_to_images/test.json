                "// Get root type\\nuint32_t root_type_id = reader.get_type_id_by_name(\\"SensorDataset\\");\\nconst pod_transfer::pod_type_descriptor_t* root_td = \\n    reader.get_type_descriptor(root_type_id);\\n\\n// Get fields\\nstd::vector<const pod_transfer::pod_field_descriptor_t*> fields;\\nreader.get_struct_fields(root_type_id, fields);\\n\\n// Access first field (assume it\'s an array)\\nconst auto* array_field = fields[0];\\nconst uint8_t* data_ptr = static_cast<const uint8_t*>(shm_ptr);\\nconst uint8_t* array_start = data_ptr + array_field->offset;\\n\\n// Find array type\\nuint32_t array_type_idx = /* find type by size/alignment */;\\nconst pod_transfer::pod_type_descriptor_t* array_td = \\n    reader.get_type_descriptor(array_type_idx);\\n\\n// Access elements\\nuint32_t element_count = array_td->array_info.element_count;\\nuint32_t element_type_idx = array_td->array_info.element_type_index;\\nconst pod_transfer::pod_type_descriptor_t* elem_td = \\n    reader.get_type_descriptor(element_type_idx);\\n\\nfor (uint32_t i = 0; i < element_count; ++i) {\\n    const uint8_t* elem_ptr = array_start + i * elem_td->size;\\n    \\n    // Now access fields within element\\n    std::vector<const pod_transfer::pod_field_descriptor_t*> elem_fields;\\n    reader.get_struct_fields(element_type_idx, elem_fields);\\n    \\n    for (const auto* field : elem_fields) {\\n        const uint8_t* field_ptr = elem_ptr + field->offset;\\n        \\n        // Cast based on field type\\n        switch (field->type) {\\n            case pod_transfer::FT_FLOAT: {\\n                float value;\\n                std::memcpy(&value, field_ptr, sizeof(float));\\n                std::cout << \\"Float: \\" << value << std::endl;\\n                break;\\n            }\\n            case pod_transfer::FT_UINT32: {\\n                uint32_t value;\\n                std::memcpy(&value, field_ptr, sizeof(uint32_t));\\n                std::cout << \\"UInt32: \\" << value << std::endl;\\n                break;\\n            }\\n            // ... handle other types\\n        }\\n    }\\n}"
            ]
        },
