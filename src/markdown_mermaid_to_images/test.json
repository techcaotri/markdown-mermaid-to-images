                    "simple-example-reader",
                    [],
                    []
                ],
                [
                    {
                        "t": "Str",
                        "c": "Simple"
                    },
                    {
                        "t": "Space"
                    },
                    {
                        "t": "Str",
                        "c": "Example:"
