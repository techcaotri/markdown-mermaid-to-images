                "#include <sys/mman.h>\\n#include <fcntl.h>\\n#include <unistd.h>\\n\\n// After generating schema\\nauto result = builder.generate_schema();\\nsize_t data_size = result.root_data_size;\\n\\n// Create shared memory\\nconst char* shm_name = \\"/my_data\\";\\nint shm_fd = shm_open(shm_name, O_CREAT | O_RDWR, 0666);\\nif (shm_fd == -1) {\\n    perror(\\"shm_open\\");\\n    return false;\\n}\\n\\n// Set size\\nif (ftruncate(shm_fd, data_size) == -1) {\\n    perror(\\"ftruncate\\");\\n    close(shm_fd);\\n    return false;\\n}\\n\\n// Map memory\\nvoid* shm_ptr = mmap(nullptr, data_size, \\n                     PROT_READ | PROT_WRITE, \\n                     MAP_SHARED, shm_fd, 0);\\nif (shm_ptr == MAP_FAILED) {\\n    perror(\\"mmap\\");\\n    close(shm_fd);\\n    return false;\\n}"
            ]
