                ],"%%{init: {\'theme\':\'base\'}}%%\\nflowchart TD\\n    A[\\"Start\\"] --> B[\\"Create SchemaBuilder\\"]\\n    B --> C[\\"Register Primitive<br/>Struct Types\\"]\\n    C --> D[\\"Register Complex<br/>Struct Types\\"]\\n    D --> E[\\"Register Array Types\\"]\\n    E --> F[\\"Set Root Type\\"]\\n    F --> G[\\"Generate Schema\\"]\\n    G --> H{\\"Success?\\"}\\n    H -->|Yes| I[\\"Save Schema File\\"]\\n    H -->|No| J[\\"Handle Error\\"]\\n    I --> K[\\"End\\"]\\n    J --> K\\n    \\n    style A fill:#e8f5e9\\n    style B fill:#c8e6c9\\n    style C fill:#a5d6a7\\n    style D fill:#81c784\\n    style E fill:#66bb6a\\n    style F fill:#4caf50\\n    style G fill:#43a047\\n    style H fill:#ffeb3b\\n    style I fill:#81c784\\n    style J fill:#ef5350\\n    style K fill:#e8f5e9"
            ]
        },
