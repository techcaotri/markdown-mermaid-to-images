                "#include \\"pod_transfer/pod_transfer.h\\"\\n#include <iostream>\\n\\nvoid print_schema_info(const std::string& schema_file) {\\n    // Load schema\\n    pod_transfer::SchemaReader reader;\\n    if (!reader.load_from_file(schema_file)) {\\n        std::cerr << \\"Failed to load: \\" << reader.get_error_message() << std::endl;\\n        return;\\n    }\\n    \\n    // Print basic info\\n    std::cout << \\"Schema loaded successfully!\\" << std::endl;\\n    std::cout << \\"Types: \\" << reader.get_type_count() << std::endl;\\n    std::cout << \\"Fields: \\" << reader.get_field_count() << std::endl;\\n    std::cout << \\"Root size: \\" << reader.get_root_data_size() << \\" bytes\\" << std::endl;\\n    std::cout << std::endl;\\n    \\n    // Print all types\\n    for (uint32_t i = 0; i < reader.get_type_count(); ++i) {\\n        const auto* td = reader.get_type_descriptor(i);\\n        if (!td) continue;\\n        \\n        std::string type_name = reader.get_type_name(i);\\n        std::cout << \\"Type[\\" << i << \\"
                ]: \\" << type_name << std::endl;\\n        std::cout << \\"  Size: \\" << td->size << \\" bytes\\" << std::endl;\\n        \\n        if (td->kind == pod_transfer::TK_STRUCT) {\\n            // Print fields\\n            std::vector<const pod_transfer::pod_field_descriptor_t*> fields;\\n            if (reader.get_struct_fields(i, fields)) {\\n                std::cout << \\"  Fields (\\" << fields.size() << \\"):\\" << std::endl;\\n                for (const auto* field : fields) {\\n                    std::string field_name = reader.get_string(field->name_offset);\\n                    std::cout << \\"    - \\" << field_name \\n                              << \\" @ offset \\" << field->offset \\n                              << \\" (size=\\" << field->size << \\")\\" << std::endl;\\n                }\\n            }\\n        } else if (td->kind == pod_transfer::TK_ARRAY) {\\n            std::cout << \\"  Element type: \\" \\n                      << reader.get_type_name(td->array_info.element_type_index) \\n                      << std::endl;\\n            std::cout << \\"  Element count: \\" \\n                      << td->array_info.element_count << std::endl;\\n        }\\n        std::cout << std::endl;\\n    }\\n}"
            ]
        },
